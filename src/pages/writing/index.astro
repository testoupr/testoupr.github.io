---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Writing — Theo Estoup Ruiz">
  <h1>Writing</h1>

  {
    posts.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <ul class="list">
        {posts.map((p) => (
          <li>
            <a href={`/writing/${p.id}`}>
              <span class="title">{p.data.title}</span>
              <time>
                {p.data.date.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  <style>
    .list {
      list-style: none;
      padding: 0;
      margin: 1.5rem 0 0;
    }
    .list li {
      border-top: 1px solid var(--border);
    }
    .list li:last-child {
      border-bottom: 1px solid var(--border);
    }
    .list a {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      padding: 0.9rem 0;
      border: none;
      color: inherit;
    }
    .list .title {
      font-weight: 600;
      color: var(--heading);
    }
    .list a:hover .title {
      color: var(--link);
    }
    .list time {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--text-muted);
      flex: none;
    }
    .empty {
      color: var(--text-muted);
      margin-top: 1.5rem;
    }
  </style>
</Base>
