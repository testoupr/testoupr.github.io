---
import "../styles/global.css";
import "katex/dist/katex.min.css";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const {
  title = "Theo Estoup Ruiz",
  description = "Applied cryptography & data security research.",
  wide = false,
} = Astro.props;

const nav = [
  { href: "/writing", label: "Writing" },
  { href: "/projects", label: "Projects" },
  { href: "/travel", label: "Travel" },
  { href: "/about", label: "About" },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>◈</text></svg>"
    />
  </head>
  <body>
    <header class="site-header">
      <div class={`wrap ${wide ? "wrap-wide" : ""}`}>
        <div class="bar">
          <a class="brand" href="/">Theo&nbsp;Estoup&nbsp;Ruiz</a>
          <nav class="nav">
            {
              nav.map((n) => (
                <a
                  href={n.href}
                  class={path.startsWith(n.href) ? "active" : ""}
                >
                  {n.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </header>

    <main class={`wrap ${wide ? "wrap-wide" : ""}`}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class={`wrap ${wide ? "wrap-wide" : ""}`}>
        <span class="mono-label">Theo Estoup Ruiz</span>
        <span class="links">
          <a href="mailto:estoupruiztheo@gmail.com">Email</a>
          <a href="https://github.com/testoupr">GitHub</a>
        </span>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border);
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        position: sticky;
        top: 0;
        backdrop-filter: saturate(1.4) blur(8px);
        z-index: 10;
      }
      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 3.4rem;
      }
      .brand {
        font-weight: 700;
        color: var(--heading);
        border: none;
        font-size: 0.98rem;
      }
      .nav {
        display: flex;
        gap: 1.1rem;
      }
      .nav a {
        color: var(--text-muted);
        border: none;
        font-size: 0.92rem;
      }
      .nav a:hover,
      .nav a.active {
        color: var(--heading);
      }
      .nav a.active {
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 2px;
        text-underline-offset: 5px;
      }
      main {
        min-height: 70vh;
        padding-top: 2.5rem;
        padding-bottom: 4rem;
      }
      .site-footer {
        border-top: 1px solid var(--border);
        padding: 1.6rem 0;
      }
      .site-footer .wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .site-footer .links {
        display: flex;
        gap: 1rem;
      }
      .site-footer a {
        color: var(--text-muted);
        border: none;
        font-size: 0.88rem;
      }
      .site-footer a:hover {
        color: var(--heading);
      }
    </style>
  </body>
</html>
