---
interface Props {
  size?: number; // displayed square size in px
}
const { size = 340 } = Astro.props;
---

<canvas
  class="ascii-portrait"
  role="img"
  aria-label="Portrait of Theo Estoup Ruiz rendered as shaded blocks — brush over it to drain the colour to monochrome"
  style={`width:${size}px;height:${size}px;`}></canvas>

<script>
  import data from "../data/headshot-ascii.json";

  const canvas = document.querySelector<HTMLCanvasElement>("canvas.ascii-portrait");
  if (canvas) {
    const cols: number = data.cols;
    const rows: number = data.rows;
    const C: number[] = data.c;
    const N = cols * rows;

    const SAT = 1.22; // saturation boost so the blocks stay vivid (not too orange)
    const WR = 0.95, WG = 1.0, WB = 1.07; // cool white-balance to kill the beige cast

    // per-cell colour: keep the photo's hue, but contrast-stretch the luminance
    // (3rd–97th pct + S-curve) and boost saturation so nothing goes muddy/dark.
    const lum = new Float64Array(N);
    for (let i = 0; i < N; i++) {
      const v = C[i];
      lum[i] = 0.299 * ((v >> 16) & 255) + 0.587 * ((v >> 8) & 255) + 0.114 * (v & 255);
    }
    const sorted = [...lum].sort((a, b) => a - b);
    const lo = sorted[Math.floor(N * 0.03)];
    const hi = sorted[Math.floor(N * 0.97)] || 255;
    const span = Math.max(1, hi - lo);
    const clamp = (x: number) => (x < 0 ? 0 : x > 255 ? 255 : x);
    const fr = new Uint8Array(N), fg = new Uint8Array(N), fb = new Uint8Array(N);
    const gray = new Uint8Array(N); // grayscale version, used by the brush
    // subtle teeth whitening: desaturate + lift the bright cells in the smile box
    const TX0 = 32, TX1 = 49, TY0 = 45, TY1 = 51, TLUM = 155, DESAT = 0.72, LIFT = 0.24;
    for (let i = 0; i < N; i++) {
      const v = C[i];
      let r = (v >> 16) & 255, g = (v >> 8) & 255, b = v & 255;
      let t = (lum[i] - lo) / span;
      t = t < 0 ? 0 : t > 1 ? 1 : t;
      t = Math.pow(t, 0.9);
      t = t + (t - 0.5) * 0.25; // S-curve pop
      t = t < 0 ? 0 : t > 1 ? 1 : t;
      const targetL = t * 255, f = targetL / Math.max(1, lum[i]);
      r *= f; g *= f; b *= f;
      r = targetL + (r - targetL) * SAT;
      g = targetL + (g - targetL) * SAT;
      b = targetL + (b - targetL) * SAT;
      r *= WR; g *= WG; b *= WB;
      r = clamp(r); g = clamp(g); b = clamp(b);
      const col = i % cols, row = (i / cols) | 0;
      const L = 0.299 * r + 0.587 * g + 0.114 * b;
      if (col >= TX0 && col <= TX1 && row >= TY0 && row <= TY1 && L >= TLUM) {
        r = r + (L - r) * DESAT; g = g + (L - g) * DESAT; b = b + (L - b) * DESAT;
        r = r + (255 - r) * LIFT; g = g + (255 - g) * LIFT; b = b + (255 - b) * LIFT;
        r = clamp(r); g = clamp(g); b = clamp(b);
      }
      fr[i] = Math.round(r);
      fg[i] = Math.round(g);
      fb[i] = Math.round(b);
      gray[i] = Math.round(0.299 * fr[i] + 0.587 * fg[i] + 0.114 * fb[i]);
    }

    // 1px-per-cell canvas, upscaled crisply by CSS (image-rendering: pixelated)
    canvas.width = cols;
    canvas.height = rows;
    const ctx = canvas.getContext("2d")!;

    const flipped = new Uint8Array(N);
    const deadline = new Float64Array(N);
    const active = new Set<number>();

    function put(i: number) {
      if (flipped[i]) {
        const gv = gray[i];
        ctx.fillStyle = `rgb(${gv},${gv},${gv})`;
      } else {
        ctx.fillStyle = `rgb(${fr[i]},${fg[i]},${fb[i]})`;
      }
      ctx.fillRect(i % cols, (i / cols) | 0, 1, 1);
    }
    for (let i = 0; i < N; i++) put(i);

    // --- sequin brush: cells invert, then heal back after a beat ---
    const R = 3.4;      // brush radius in cells
    const HOLD = 900;   // ms a sequin stays flipped
    const JITTER = 500; // per-cell randomness so they shimmer back

    function flip(i: number) {
      deadline[i] = performance.now() + HOLD + Math.random() * JITTER;
      if (!flipped[i]) {
        flipped[i] = 1;
        active.add(i);
        put(i);
      }
    }

    function brush(clientX: number, clientY: number) {
      const rect = canvas!.getBoundingClientRect();
      const cx = ((clientX - rect.left) / rect.width) * cols;
      const cy = ((clientY - rect.top) / rect.height) * rows;
      const c0 = Math.max(0, Math.floor(cx - R));
      const c1 = Math.min(cols - 1, Math.ceil(cx + R));
      const r0 = Math.max(0, Math.floor(cy - R));
      const r1 = Math.min(rows - 1, Math.ceil(cy + R));
      for (let ry = r0; ry <= r1; ry++) {
        for (let rx = c0; rx <= c1; rx++) {
          const dx = rx + 0.5 - cx, dy = ry + 0.5 - cy;
          if (dx * dx + dy * dy <= R * R) flip(ry * cols + rx);
        }
      }
    }

    canvas.addEventListener("pointermove", (e) => brush(e.clientX, e.clientY));

    // heal loop: revert cells whose time is up
    const tick = (now: number) => {
      for (const i of active) {
        if (now >= deadline[i]) {
          flipped[i] = 0;
          active.delete(i);
          put(i);
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    // --- one-time hint sweep so the effect is discoverable ---
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setTimeout(() => {
        let col = 0;
        const step = () => {
          if (col < cols) {
            for (let ry = 0; ry < rows; ry++) flip(ry * cols + col);
            col++;
            setTimeout(step, 20);
          }
        };
        step();
      }, 450);
    }
  }
</script>

<style>
  .ascii-portrait {
    display: block;
    border-radius: 14px;
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
    cursor: crosshair;
    touch-action: none;
    background: #f0ede7;
    image-rendering: pixelated;
  }
</style>
